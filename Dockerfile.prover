FROM haskell:9.10.3 AS dependencies
WORKDIR /opt/build

RUN apt-get update && apt-get install -y \
    git libexpat1-dev liblmdb-dev liblzma-dev libz-dev pkg-config

# Layer cache: only rebuild dependencies when cabal files change
COPY rpki-prover.cabal cabal.project /opt/build/
RUN cabal update && cabal build --only-dependencies exe:rpki-prover

# -------------------------------------------------------------------------------------------
FROM haskell:9.10.3 AS build

RUN apt-get update && apt-get install -y \
    git libexpat1-dev liblmdb-dev liblzma-dev libz-dev pkg-config

WORKDIR /opt/build

# Restore pre-compiled packages from the dependency cache; no dist-newstyle
# (dist-newstyle from dependencies stage has no source tree baked in)
COPY --from=dependencies /root/.cabal /root/.cabal
COPY . /opt/build/

RUN cabal install exe:rpki-prover \
    --install-method=copy \
    --installdir=/opt/build/bin \
    --overwrite-policy=always

# -------------------------------------------------------------------------------------------
FROM ubuntu:22.04 AS prover

RUN apt-get update && apt-get install -y \
    libgmp-dev libexpat1-dev liblmdb-dev liblzma-dev curl rsync libz-dev \
    && rm -rf /var/lib/apt/lists/*

VOLUME /rpki-data/
RUN mkdir -p /opt/app
WORKDIR /opt/app

COPY --from=build /opt/build/bin/rpki-prover .
EXPOSE 9999
ENTRYPOINT ["/opt/app/rpki-prover", "--rpki-root-directory", "/rpki-data"]

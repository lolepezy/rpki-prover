packages: .

with-compiler: ghc-9.10.3

-- Mirrors stack.yaml allow-newer: true
allow-newer: True

-- Git dependencies (stack.yaml extra-deps)
source-repository-package
  type: git
  location: https://github.com/lolepezy/lmdb-high-level.git
  tag: c1bfd9564b5a894659428281f328df2975d04569

source-repository-package
  type: git
  location: https://github.com/lolepezy/hs-connection
  tag: e3cf8623979f8687694280939349734868cd18ac

source-repository-package
  type: git
  location: https://github.com/lolepezy/bytestring-mmap
  tag: 244367f5febcc44ca9e673dedbf00874395de406

source-repository-package
  type: git
  location: https://github.com/well-typed/ixset-typed
  tag: 984b26cbbfc39c68905a5675de61c50706ab9f73

-- macOS Homebrew paths for C libraries (lmdb etc.); harmless on Linux
package lmdb
  extra-include-dirs: /opt/homebrew/include /usr/local/include
  extra-lib-dirs:     /opt/homebrew/lib     /usr/local/lib

-- Pinned Hackage versions (stack.yaml extra-deps)
constraints:
    hw-ip == 2.4.2.1
  , insert-ordered-containers == 0.2.6
  , servant-swagger == 1.2.1
  , swagger2 == 2.8.9

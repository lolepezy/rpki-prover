-- perf branch: merges perf-encoding, perf-types and perf-parse (each also
-- pushed on its own branch). Cuts saveSnapshot CPU roughly in half on a
-- 700MB RRDP snapshot; see the branches' commit messages for what changed.
source-repository-package
  type: git
  location: https://github.com/lolepezy/crypton-asn1
  tag: f1763fc859a74767cb5779931c7ae4d4946ee68e
  subdir:
    types
    encoding
    parse

-- Pinned Hackage versions (stack.yaml extra-deps)
constraints:
    hw-ip == 2.4.2.1
  , effectful >= 2.7 && < 2.8
  , effectful-core >= 2.7 && < 2.8
  , insert-ordered-containers == 0.2.6
  , servant-swagger == 1.2.1
  , swagger2 == 2.8.9

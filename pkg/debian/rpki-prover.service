[Unit]
Description=RPKI Prover, RPKI relying party software
Documentation=man:rpki-prover(1)
Documentation=https://github.com/lolepezy/rpki-prover
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=rpki-prover
Group=rpki-prover
WorkingDirectory=/var/lib/rpki-prover

# --rpki-root-directory below makes rpki-prover ignore $HOME, but it falls back
# to ${HOME}/.rpki if that option is ever dropped from a drop-in, so give it
# something sane to fall back to.
Environment=HOME=/var/lib/rpki-prover
EnvironmentFile=-/etc/default/rpki-prover
ExecStart=/usr/bin/rpki-prover --rpki-root-directory /var/lib/rpki-prover $RPKI_PROVER_ARGS

Restart=on-failure
RestartSec=10
# A validation cycle spawns worker processes; give them time to wind down.
TimeoutStopSec=60
KillMode=control-group

StateDirectory=rpki-prover
StateDirectoryMode=0750
LimitNOFILE=65536

# --- Hardening -------------------------------------------------------------
# CAP_NET_BIND_SERVICE is not needed for the default ports (9999 HTTP,
# 8283 RTR) but lets an operator move either below 1024 without editing this
# unit.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rpki-prover
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The landlock_* syscalls are spelled out because @system-service only started
# pulling in @sandbox, which holds them, in systemd 253. On bookworm's 252 they
# are otherwise denied, the worker's Landlock sandbox can't be set up, and the
# worker falls back to running unsandboxed with only a warning in the log.
# @sandbox itself cannot be named here: 252 does not know that set at all.
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
# NOTE: MemoryDenyWriteExecute is deliberately *not* set. The GHC runtime uses
# libffi to build closures for "foreign import ccall wrapper" callbacks, which
# needs writable-then-executable memory on some libffi versions.

[Install]
WantedBy=multi-user.target

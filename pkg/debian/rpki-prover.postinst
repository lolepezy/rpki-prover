#!/bin/sh
set -e

RPKI_PROVER_USER=rpki-prover
RPKI_PROVER_GROUP=rpki-prover
RPKI_PROVER_HOME=/var/lib/rpki-prover

case "$1" in
    configure)
        if ! getent passwd "${RPKI_PROVER_USER}" >/dev/null; then
            adduser --system --group --quiet \
                --home "${RPKI_PROVER_HOME}" --no-create-home \
                --gecos "RPKI Prover" "${RPKI_PROVER_USER}"
        fi

        # rpki-prover creates cache/, rsync/ and tmp/ itself but expects
        # tals/ to already exist. Not recursive on purpose: the cache under
        # this directory can be several gigabytes.
        install -d -o "${RPKI_PROVER_USER}" -g "${RPKI_PROVER_GROUP}" -m 0750 \
            "${RPKI_PROVER_HOME}" "${RPKI_PROVER_HOME}/tals"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

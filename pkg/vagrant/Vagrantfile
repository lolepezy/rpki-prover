# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Throwaway VMs for testing the rpki-prover packages against real systemd:
# the .deb for the Debian/Ubuntu machines, the .rpm for the EL ones. Packages
# are expected in pkg/packages/<codename>/ -- build them first with
# pkg/build-packages.sh or pkg/build-rpm-packages.sh.
#
#   cd pkg/vagrant
#   vagrant up bookworm            # boots and runs the full test suite
#   vagrant up el9                 # the same for the RPM, on Rocky Linux 9
#   vagrant provision bookworm     # re-run the tests on a running VM
#   vagrant destroy -f bookworm
#
# To also exercise the upgrade path, drop the previous release's package into
# pkg/packages/<codename>/old/.
#
# Boxes can be overridden, which is how you point "sid" at an actual sid box:
#   RPKI_PROVER_BOX_SID=my/sid64 vagrant up sid

REPO_ROOT = File.expand_path("../..", __dir__)
PKG_DIR   = File.join(REPO_ROOT, "pkg")

MACHINES = {
  # codename    box                                                    memory  cpus  format
  "bookworm" => [ENV.fetch("RPKI_PROVER_BOX_BOOKWORM", "debian/bookworm64"), 4096, 2, "deb"],
  "trixie"   => [ENV.fetch("RPKI_PROVER_BOX_TRIXIE",   "debian/trixie64"),   4096, 2, "deb"],
  # Debian does not publish an official "sid" box; debian/testing64 tracks the
  # current testing suite and is the closest thing that is always available.
  "sid"      => [ENV.fetch("RPKI_PROVER_BOX_SID",      "debian/testing64"),  4096, 2, "deb"],
  "jammy"    => [ENV.fetch("RPKI_PROVER_BOX_JAMMY",    "ubuntu/jammy64"),    4096, 2, "deb"],
  "noble"    => [ENV.fetch("RPKI_PROVER_BOX_NOBLE",    "ubuntu/noble64"),    4096, 2, "deb"],
  # One package per EL major version covers RHEL, Rocky, AlmaLinux and Oracle
  # Linux alike; point these at e.g. almalinux/9 to try another rebuild.
  "el9"      => [ENV.fetch("RPKI_PROVER_BOX_EL9",      "rocky-9-latest"),    4096, 2, "rpm"],
  "el10"     => [ENV.fetch("RPKI_PROVER_BOX_EL10",     "rocky-10-latest"),   4096, 2, "rpm"],
}

# The rockylinux/* boxes on Vagrant Cloud point at download URLs that no longer
# exist; Rocky publishes current boxes on its own mirror instead, one file per
# provider. Used only for the default box names above.
#
# Their libvirt boxes also declare a 5 GB disk in metadata.json for a 10 GB
# image, and vagrant-libvirt believes the metadata: the VM gets a 5 GB overlay,
# the root partition runs past its end, and the guest drops into the dracut
# emergency shell while vagrant waits forever for an IP address.
ROCKY_IMAGES = "https://dl.rockylinux.org/pub/rocky/%s/images/x86_64"
BOXES = {
  "rocky-9-latest" => {
    "libvirt"         => "#{ROCKY_IMAGES % 9}/Rocky-9-Vagrant-Libvirt.latest.x86_64.vagrant.libvirt.box",
    "virtualbox"      => "#{ROCKY_IMAGES % 9}/Rocky-9-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box",
    "libvirt_disk_gb" => 10,
  },
  "rocky-10-latest" => {
    "libvirt"         => "#{ROCKY_IMAGES % 10}/Rocky-10-Vagrant-Libvirt.latest.x86_64.vagrant.libvirt.box",
    "virtualbox"      => "#{ROCKY_IMAGES % 10}/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box",
    "libvirt_disk_gb" => 10,
  },
}

# Give the daemon room: a cold start pulls the whole RPKI repository set.
SERVICE_TIMEOUT = ENV.fetch("RPKI_PROVER_SERVICE_TIMEOUT", "180")

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false

  MACHINES.each do |codename, (box, memory, cpus, format)|
    config.vm.define codename, autostart: false do |node|
      node.vm.box = box
      node.vm.hostname = "rpki-prover-#{codename}"

      # rsync works with every provider and keeps the VM disposable.
      node.vm.synced_folder PKG_DIR, "/opt/rpki-prover-pkg",
        type: "rsync",
        rsync__exclude: [".git/"],
        rsync__args: ["-a", "--delete"]

      box_info = BOXES.fetch(box, {})

      node.vm.provider "libvirt" do |lv, override|
        lv.memory = memory
        lv.cpus   = cpus
        lv.machine_virtual_size = box_info["libvirt_disk_gb"] if box_info["libvirt_disk_gb"]
        override.vm.box_url = box_info["libvirt"] if box_info["libvirt"]
      end

      node.vm.provider "virtualbox" do |vb, override|
        vb.memory = memory
        vb.cpus   = cpus
        vb.name   = "rpki-prover-#{codename}"
        override.vm.box_url = box_info["virtualbox"] if box_info["virtualbox"]
      end

      node.vm.provision "shell",
        env: {
          "CODENAME"        => codename,
          "FORMAT"          => format,
          "SERVICE_TIMEOUT" => SERVICE_TIMEOUT,
        },
        inline: <<-'SHELL'
          set -euo pipefail

          PKG_DIR="/opt/rpki-prover-pkg/packages/${CODENAME}"

          if [ ! -d "${PKG_DIR}" ]; then
            echo "No packages for ${CODENAME}: expected ${PKG_DIR}." >&2
            echo "Run pkg/build-packages.sh ${CODENAME} on the host first." >&2
            exit 1
          fi

          if [ "${FORMAT}" = "rpm" ]; then
            RPM=$(find "${PKG_DIR}" -maxdepth 1 -name 'rpki-prover-*.rpm' | sort -V | tail -1)
            if [ -z "${RPM}" ]; then
              echo "No rpki-prover-*.rpm in ${PKG_DIR}" >&2
              exit 1
            fi

            OLD_RPM=$(find "${PKG_DIR}/old" -maxdepth 1 -name 'rpki-prover-*.rpm' 2>/dev/null | sort -V | tail -1)

            ARGS=(--rpm "${RPM}" --service-timeout "${SERVICE_TIMEOUT}")
            if [ -n "${OLD_RPM}" ]; then
              echo "Upgrade test will use ${OLD_RPM}"
              ARGS+=(--old-rpm "${OLD_RPM}")
            else
              echo "No package in ${PKG_DIR}/old, skipping the upgrade test."
            fi

            exec /opt/rpki-prover-pkg/test-scripts/test-rpki-prover-rpm.sh "${ARGS[@]}" all
          fi

          DEB=$(find "${PKG_DIR}" -maxdepth 1 -name 'rpki-prover_*.deb' | sort | tail -1)
          if [ -z "${DEB}" ]; then
            echo "No rpki-prover_*.deb in ${PKG_DIR}" >&2
            exit 1
          fi

          OLD_DEB=$(find "${PKG_DIR}/old" -maxdepth 1 -name 'rpki-prover_*.deb' 2>/dev/null | sort | tail -1)

          export DEBIAN_FRONTEND=noninteractive
          apt-get update

          ARGS=(--deb "${DEB}" --service-timeout "${SERVICE_TIMEOUT}")
          if [ -n "${OLD_DEB}" ]; then
            echo "Upgrade test will use ${OLD_DEB}"
            ARGS+=(--old-deb "${OLD_DEB}")
          else
            echo "No package in ${PKG_DIR}/old, skipping the upgrade test."
          fi

          exec /opt/rpki-prover-pkg/test-scripts/test-rpki-prover.sh "${ARGS[@]}" all
        SHELL
    end
  end
end

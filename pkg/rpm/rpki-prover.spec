# RPM packaging for rpki-prover, the counterpart of pkg/debian/.
#
# Like pkg/debian/rules this is not something an SRPM could rebuild anywhere:
# GHC and cabal come from ghcup, so it only builds in the image from
# pkg/Dockerfile.rpm-builder. pkg/build-rpm-in-container.sh runs
#
#   rpmbuild -bb --build-in-place --define 'upstream_version ...' --define 'rpm_release ...'
#
# over a copy of the checkout, so every path below is relative to the
# repository root.
#
# The systemd unit is pkg/debian/rpki-prover.service with the environment file
# moved to /etc/sysconfig, so that the hardening is defined in one place only.

%{!?upstream_version: %{error: upstream_version must be defined}}
%{!?rpm_release: %global rpm_release 1}

# GHC binaries carry DWARF that debugedit and dwz regularly choke on, and a
# -debuginfo package for a binary this size is not worth shipping.
%global debug_package %{nil}

%global rpki_user  rpki-prover
%global rpki_home  %{_sharedstatedir}/rpki-prover

Name:           rpki-prover
Version:        %{upstream_version}
Release:        %{rpm_release}%{?dist}
Summary:        RPKI relying party software (validator)
License:        BSD-3-Clause
URL:            https://github.com/lolepezy/rpki-prover

# GHC and cabal are deliberately absent; see the comment in pkg/debian/control.
# Keep in sync with the dnf line in pkg/Dockerfile.rpm-builder.
BuildRequires:  gmp-devel
BuildRequires:  xz-devel
BuildRequires:  zlib-devel
BuildRequires:  systemd-rpm-macros

# Shared library dependencies (libgmp, liblzma, libz, ...) are generated by
# rpmbuild from the binary itself.
Requires:       rsync
Requires(pre):  shadow-utils
%{?systemd_requires}

%description
The Resource Public Key Infrastructure (RPKI) provides cryptographically
signed statements about the association of Internet routing resources. In
particular it allows the holder of an IP address prefix to publish which AS
number is authorised to originate BGP announcements for it.

RPKI Prover is a relying party implementation: it fetches the RPKI
repositories over rsync and RRDP, validates the certificate tree and
publishes the resulting VRPs, ASPA objects and BGPSec keys over an HTTP API
(CSV/JSON), a web UI, Prometheus metrics and the RTR protocol (RFC 8210).

It also supports SLURM (RFC 8416), RPKI Signed Checklists and RPKI Prefix
Lists, and runs fetching and validation in isolated worker processes with
memory and time limits to contain misbehaving or hostile repositories.

This package installs rpki-prover as a systemd service running as the
dedicated "rpki-prover" system user, with its state under
/var/lib/rpki-prover. As usual for RPM-based systems the service is not
enabled on installation; run "systemctl enable --now rpki-prover". On its
first start it downloads the five RIR trust anchor locators itself.

%build
export PATH=/opt/.ghcup/bin:/opt/cabal/bin:$PATH
export CABAL_DIR=${CABAL_DIR:-/opt/cabal}
mkdir -p stage
cabal -j install exe:rpki-prover \
    --install-method=copy \
    --installdir=stage \
    --overwrite-policy=always
# As in pkg/debian/rules: a help2man hiccup must not fail the build.
help2man --no-info --section=1 \
    --name='RPKI relying party software' \
    --version-string='%{version}-%{release}' \
    --include=pkg/rpm/rpki-prover.h2m \
    --output=stage/rpki-prover.1 \
    stage/rpki-prover \
  || sed -e 's|@VERSION@|%{version}-%{release}|' \
         -e 's|/etc/default/rpki-prover|%{_sysconfdir}/sysconfig/rpki-prover|g' \
         pkg/debian/rpki-prover.1.fallback > stage/rpki-prover.1

%install
# rpmbuild's own brp-strip only runs "strip -g", which leaves the symbol
# table, i.e. most of a GHC binary's 110 MB. Strip it the way dh_strip does
# for the .deb.
strip --strip-unneeded --remove-section=.comment --remove-section=.note stage/rpki-prover
install -D -m 0755 stage/rpki-prover %{buildroot}%{_bindir}/rpki-prover
install -D -m 0644 stage/rpki-prover.1 %{buildroot}%{_mandir}/man1/rpki-prover.1
install -D -m 0644 pkg/rpm/rpki-prover.sysconfig %{buildroot}%{_sysconfdir}/sysconfig/rpki-prover
install -D -m 0644 pkg/rpm/rpki-prover.sysusers %{buildroot}%{_sysusersdir}/rpki-prover.conf
install -d -m 0755 %{buildroot}%{_unitdir}
sed -e 's|/etc/default/rpki-prover|%{_sysconfdir}/sysconfig/rpki-prover|g' \
    pkg/debian/rpki-prover.service > %{buildroot}%{_unitdir}/rpki-prover.service
grep -q '^EnvironmentFile=-%{_sysconfdir}/sysconfig/rpki-prover$' \
    %{buildroot}%{_unitdir}/rpki-prover.service
# rpki-prover creates cache/, rsync/ and tmp/ itself but expects tals/ to
# already exist.
install -d -m 0750 %{buildroot}%{rpki_home}/tals

%pre
# The sysusers.d file is shipped as well, and rpm >= 4.19 (EL10) applies it on
# its own; this covers EL9, whose rpm does not.
getent group %{rpki_user} >/dev/null || groupadd -r %{rpki_user}
getent passwd %{rpki_user} >/dev/null || \
    useradd -r -g %{rpki_user} -d %{rpki_home} -s /sbin/nologin \
        -c 'RPKI Prover' %{rpki_user}
exit 0

%post
%systemd_post rpki-prover.service

%preun
%systemd_preun rpki-prover.service

%postun
%systemd_postun_with_restart rpki-prover.service
# There is no purge in RPM: like most packages, this one leaves the system
# user and the cache under /var/lib/rpki-prover in place on erase.

%files
%license LICENSE
%doc README.md
%{_bindir}/rpki-prover
%{_mandir}/man1/rpki-prover.1*
%{_unitdir}/rpki-prover.service
%{_sysusersdir}/rpki-prover.conf
%config(noreplace) %{_sysconfdir}/sysconfig/rpki-prover
%dir %attr(0750,%{rpki_user},%{rpki_user}) %{rpki_home}
%dir %attr(0750,%{rpki_user},%{rpki_user}) %{rpki_home}/tals

# pkg/build-rpm-in-container.sh appends the entry for the version being built.
%changelog
